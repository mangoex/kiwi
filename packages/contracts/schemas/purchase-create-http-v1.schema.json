{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restaurantos.local/schemas/purchase-create-http-v1.schema.json",
  "title": "Online purchase creation v1 (Idempotency-Key header)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branch_id",
    "supplier_id",
    "document_type",
    "folio",
    "document_date",
    "payment_method",
    "paid_from_cash",
    "lines"
  ],
  "$defs": {
    "decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$"
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentation_id",
        "quantity",
        "unit_price",
        "discount",
        "tax"
      ],
      "properties": {
        "presentation_id": {
          "type": "string",
          "format": "uuid"
        },
        "quantity": {
          "$ref": "#/$defs/decimal"
        },
        "unit_price": {
          "$ref": "#/$defs/decimal"
        },
        "discount": {
          "$ref": "#/$defs/decimal"
        },
        "tax": {
          "$ref": "#/$defs/decimal"
        }
      }
    }
  },
  "properties": {
    "branch_id": {
      "type": "string",
      "format": "uuid"
    },
    "supplier_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_type": {
      "enum": [
        "invoice",
        "receipt",
        "ticket",
        "note"
      ]
    },
    "folio": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "document_date": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "payment_method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "paid_from_cash": {
      "type": "boolean"
    },
    "freight_total": {
      "const": "0"
    },
    "notes": {
      "type": "string",
      "maxLength": 600
    },
    "evidence_url": {
      "type": "string",
      "maxLength": 600
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/line"
      }
    }
  }
}

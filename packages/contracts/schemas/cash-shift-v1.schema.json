{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restaurantos.local/contracts/cash-shift-v1.schema.json",
  "type": "object",
  "required": [
    "id", "organization_id", "branch_id", "register_code", "status",
    "opening_cash_cents", "opened_at", "closed_at", "created_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "branch_id": { "type": "string", "minLength": 1 },
    "register_code": { "type": "string", "minLength": 1, "maxLength": 32 },
    "status": { "enum": ["OPEN", "CLOSING", "OPERATIVELY_CLOSED", "CLOSED"] },
    "opening_cash_cents": { "type": "integer", "minimum": 0 },
    "opened_at": { "type": "string", "format": "date-time" },
    "closed_at": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

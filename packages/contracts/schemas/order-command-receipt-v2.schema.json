{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "projection": {
      "const": "operational",
      "default": "operational",
      "title": "Projection",
      "type": "string"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "integer"
    },
    "action": {
      "enum": [
        "order.create",
        "payment.confirm"
      ],
      "title": "Action",
      "type": "string"
    },
    "command_id": {
      "title": "Command Id",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "order_id": {
      "title": "Order Id",
      "type": "string"
    },
    "branch_id": {
      "title": "Branch Id",
      "type": "string"
    },
    "status": {
      "const": "accepted",
      "default": "accepted",
      "title": "Status",
      "type": "string"
    },
    "accepted_at": {
      "format": "date-time",
      "title": "Accepted At",
      "type": "string"
    }
  },
  "required": [
    "policy_version",
    "action",
    "command_id",
    "id",
    "order_id",
    "branch_id",
    "accepted_at"
  ],
  "title": "OrderCommandReceiptV2",
  "type": "object"
}

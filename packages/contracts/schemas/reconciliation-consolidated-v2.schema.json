{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:restaurantos:reconciliation-consolidated:v2",
  "type": "object",
  "required": [
    "contract_version",
    "population",
    "physical_count",
    "summary",
    "activity",
    "date_from",
    "date_to",
    "branches",
    "supplier_totals",
    "fixed_expense_totals"
  ],
  "properties": {
    "contract_version": {
      "const": 2
    },
    "population": {
      "type": "object",
      "required": [
        "kind",
        "shift_ids",
        "breakdown_basis"
      ],
      "properties": {
        "kind": {
          "const": "shifts_opened"
        },
        "shift_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "breakdown_basis": {
          "const": "verified_ledger"
        }
      }
    },
    "physical_count": {
      "type": "object",
      "required": [
        "status",
        "counted_shift_ids",
        "pending_shift_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "COUNTED",
            "EMPTY"
          ]
        },
        "counted_shift_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "pending_shift_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "PENDING"
            },
            "pending_shift_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "COUNTED"
            },
            "counted_shift_ids": {
              "minItems": 1
            },
            "pending_shift_ids": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "EMPTY"
            },
            "counted_shift_ids": {
              "maxItems": 0
            },
            "pending_shift_ids": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "total_sales",
        "total_cards",
        "total_transfers",
        "total_credits",
        "total_suppliers",
        "total_fixed",
        "total_withdrawals",
        "total_expected_cash",
        "physical_cash_count",
        "difference"
      ],
      "properties": {
        "total_sales": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "total_cards": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "total_transfers": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "total_credits": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "total_suppliers": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "total_fixed": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "total_withdrawals": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "total_expected_cash": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "physical_cash_count": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "difference": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "activity": {
      "type": "object",
      "required": [
        "kind",
        "totals"
      ],
      "properties": {
        "kind": {
          "const": "calendar_events"
        },
        "totals": {
          "type": "object",
          "required": [
            "total_sales_with_tax",
            "card_payments",
            "transfer_payments",
            "credit_sales",
            "cash_sales",
            "supplier_expenses",
            "fixed_expenses",
            "cash_withdrawals",
            "cash_deposits"
          ],
          "properties": {
            "total_sales_with_tax": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            "card_payments": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            "transfer_payments": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            "credit_sales": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            "cash_sales": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            "supplier_expenses": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            "fixed_expenses": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            "cash_withdrawals": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            "cash_deposits": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "date_from": {
      "type": "string",
      "format": "date"
    },
    "date_to": {
      "type": "string",
      "format": "date"
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "branch_id",
          "branch_name",
          "total_sales",
          "total_expenses"
        ],
        "properties": {
          "branch_id": {
            "type": "string"
          },
          "branch_name": {
            "type": "string"
          },
          "total_sales": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
          },
          "total_expenses": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
          }
        }
      }
    },
    "supplier_totals": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
      }
    },
    "fixed_expense_totals": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "physical_count": {
            "properties": {
              "status": {
                "const": "COUNTED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "summary": {
            "properties": {
              "physical_cash_count": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              "difference": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "summary": {
            "properties": {
              "physical_cash_count": {
                "type": "null"
              },
              "difference": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}

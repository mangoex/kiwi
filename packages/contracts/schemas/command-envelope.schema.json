{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://restaurantos.local/schemas/command-envelope.schema.json",
  "title": "CommandEnvelope",
  "type": "object",
  "required": [
    "schema_version",
    "command_id",
    "idempotency_key",
    "organization_id",
    "branch_id",
    "source_device_id",
    "actor_user_id",
    "command_type",
    "occurred_at",
    "accepted_at",
    "offline_grant",
    "payload"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "command_id": { "type": "string", "format": "uuid" },
    "idempotency_key": { "type": "string", "minLength": 12, "maxLength": 160 },
    "organization_id": { "type": "string", "format": "uuid" },
    "branch_id": { "type": "string", "format": "uuid" },
    "source_device_id": { "type": "string", "format": "uuid" },
    "actor_user_id": { "type": "string", "format": "uuid" },
    "command_type": { "type": "string", "const": "cash.movement.create.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "accepted_at": { "type": "string", "format": "date-time" },
    "offline_grant": { "type": "string", "minLength": 20 },
    "payload": {
      "type": "object",
      "required": [
        "register_id",
        "movement_type",
        "concept_id",
        "amount_cents",
        "reference",
        "evidence_refs"
      ],
      "properties": {
        "register_id": { "type": "string", "minLength": 1 },
        "movement_type": { "enum": ["deposit", "withdrawal"] },
        "concept_id": { "type": "string", "format": "uuid" },
        "amount_cents": { "type": "integer", "minimum": 1 },
        "reference": { "type": "string", "minLength": 1, "maxLength": 600 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

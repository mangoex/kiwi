{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "next_cursor"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "folio",
          "branch_id",
          "status",
          "service_type",
          "total_cents",
          "currency",
          "created_at",
          "payment_status",
          "payment_method_intent",
          "driver_id",
          "driver_name",
          "settlement_eligible",
          "production_summary",
          "reopen_eligible",
          "active_reopen_request_status"
        ],
        "properties": {
          "id": {"type": "string"},
          "folio": {"type": "string"},
          "branch_id": {"type": "string"},
          "cash_shift_id": {"type": ["string", "null"]},
          "register_code": {"type": ["string", "null"]},
          "status": {"type": "string"},
          "service_type": {"enum": ["dine-in", "takeout", "delivery"]},
          "total_cents": {"type": "integer"},
          "currency": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "customer_label": {"type": ["string", "null"]},
          "payment_status": {"enum": ["UNPAID", "PENDING", "CONFIRMED"]},
          "payment_method_intent": {
            "type": ["string", "null"],
            "enum": ["cash", "debit_card", "credit_card", "transfer", null]
          },
          "driver_id": {"type": ["string", "null"]},
          "driver_name": {"type": ["string", "null"]},
          "settlement_eligible": {"type": "boolean"},
          "production_summary": {"type": "object"},
          "reopen_eligible": {"type": "boolean"},
          "active_reopen_request_status": {"type": ["string", "null"]}
        }
      }
    },
    "next_cursor": {"type": ["string", "null"]}
  }
}
